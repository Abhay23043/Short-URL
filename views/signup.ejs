<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Signup - URL Shortener</title>

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:Segoe UI,Tahoma,Geneva,Verdana,sans-serif;
        }

        body{
            min-height:100vh;
            display:flex;
            justify-content:center;
            align-items:center;
            background:linear-gradient(135deg,#0ea5e9,#3b82f6);
        }

        .container{
            width:90%;
            max-width:1300px;
            height:85vh;
            display:flex;
            background:#fff;
            border-radius:25px;
            overflow:hidden;
            box-shadow:0 20px 40px rgba(0,0,0,.15);
        }

        /* LEFT SIDE */

        .left{
            flex:1.2;
            background:linear-gradient(135deg,#2563eb,#06b6d4);
            color:white;
            display:flex;
            flex-direction:column;
            justify-content:center;
            padding:70px;
        }

        .left h1{
            font-size:55px;
            margin-bottom:20px;
        }

        .left p{
            font-size:20px;
            line-height:35px;
            max-width:450px;
        }

        /* RIGHT SIDE */

        .right{
            flex:1;
            padding:60px;
            display:flex;
            flex-direction:column;
            justify-content:center;
        }

        .right h2{
            font-size:34px;
            margin-bottom:30px;
            color:#222;
        }

        label{
            display:block;
            margin-top:18px;
            margin-bottom:8px;
            font-weight:600;
            color:#444;
        }

        input{
            width:100%;
            padding:14px;
            border:1px solid #ccc;
            border-radius:10px;
            font-size:16px;
        }

        input:focus{
            outline:none;
            border-color:#2563eb;
        }

        button{
            width:100%;
            margin-top:30px;
            padding:15px;
            border:none;
            border-radius:10px;
            background:#2563eb;
            color:white;
            font-size:18px;
            cursor:pointer;
            transition:.3s;
        }

        button:hover{
            background:#1d4ed8;
        }

        .switch-page{
            margin-top:30px;
            text-align:center;
        }

        .switch-page p{
            margin-bottom:10px;
            color:#666;
        }

        .switch-btn{
            text-decoration:none;
            color:#2563eb;
            font-weight:bold;
        }

        .switch-btn:hover{
            text-decoration:underline;
        }

        @media(max-width:768px){

            .container{
                flex-direction:column;
                height:auto;
                margin:20px;
            }

            .left{
                padding:40px;
                text-align:center;
            }

            .left h1{
                font-size:38px;
            }

            .left p{
                font-size:16px;
                line-height:28px;
            }

            .right{
                padding:35px 25px;
            }

            .right h2{
                text-align:center;
                font-size:28px;
            }
        }

    </style>

</head>
<body>

<div class="container">

    <div class="left">
        <h1>Join URL Shortener</h1>

        <p>
            Create your free account and start shortening,
            organizing and sharing your links securely.
        </p>
    </div>

    <div class="right">

        <h2>Create Account</h2>

        <form action="/user" method="POST">

            <label>Full Name</label>
            <input type="text" name="name" placeholder="Enter your full name" required>

            <label>Email</label>
            <input type="email" name="email" placeholder="Enter your email" required>

            <label>Password</label>
            <input type="password" name="password" placeholder="Create a password" required>

            <button type="submit">Signup</button>

        </form>

        <div class="switch-page">
            <p>Already have an account?</p>
            <a href="/login" class="switch-btn">Login Here</a>
        </div>

    </div>

</div>

</body>
</html>