<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <style>
        .alert-success {
            color: rgb(74, 203, 15);
            font-weight: bold;
            font-size: 15px;
        }
    </style>
</head>

<body>
    <h1>Welcome to the URL Shortener</h1>
    <div>
        <form action="/url" method="post">
            <label>Enter Your Original URL: </label>
            <input type="text" name="url" placeholder="Enter your original URL here" required>
            <button type="submit">Generate</button>
        </form>

    </div>
    <% if (locals.id) { %>
        <p class="alert-success">
            Short URL Generated:
            <a href="/url/<%= id %>">
                <%= baseUrl %>/url/<%= id %>
            </a>
        </p>
        <% } %>

</body>

</html>