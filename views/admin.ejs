<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Dashboard</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#f5f5f5;
}

header{
    background:#2563eb;
    color:white;
    padding:20px 50px;

    display:flex;
    justify-content:space-between;
    align-items:center;
}

header a{
    color:white;
    text-decoration:none;
    background:#1d4ed8;
    padding:10px 18px;
    border-radius:6px;
}

.container{
    width:80%;
    max-width:900px;
    margin:50px auto;
}

.card{
    background:white;
    padding:40px;
    border-radius:10px;
    box-shadow:0 5px 15px rgba(0,0,0,.1);
}

.card h2{
    color:#2563eb;
    margin-bottom:15px;
}

.card p{
    color:#555;
    line-height:28px;
}

.menu{
    margin-top:35px;
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:20px;
}

.item{
    background:#eef4ff;
    padding:25px;
    border-radius:10px;
    text-align:center;
    cursor:pointer;
    transition:.3s;
}

.item:hover{
    background:#dbeafe;
}

.item h3{
    color:#2563eb;
    margin-bottom:8px;
}

.item p{
    font-size:14px;
}

@media(max-width:768px){

header{
    padding:20px;
    flex-direction:column;
    gap:15px;
}

.container{
    width:95%;
}

.menu{
    grid-template-columns:1fr;
}

}
</style>

</head>
<body>

<header>

    <h2>Admin Portal</h2>

    <a href="/">Home</a>

</header>

<div class="container">

    <div class="card">

        <h2>Welcome Admin 👋</h2>

        <p>
            This is the administrator panel of the URL Shortener project.
            Here you can manage users, URLs, and monitor the application. <br>  
            <b>THIS IS UNDERMAINTENACE</b>
        </p>

        <div class="menu">

            <div class="item">
                <h3>👥 Manage Users</h3>
                <p>User management section</p>
            </div>

            <div class="item">
                <h3>🔗 Manage URLs</h3>
                <p>View and remove URLs</p>
            </div>

            <div class="item">
                <h3>📊 Analytics</h3>
                <p>View application statistics</p>
            </div>

            <div class="item">
                <h3>⚙ Settings</h3>
                <p>Application settings</p>
            </div>

        </div>

    </div>

</div>

</body>
</html>
